{
	"manifest_version": 3,
	"name": "Zoom Notify",
	"version": "1.0",
	"permissions": [
		"nativeMessaging",
		"notifications"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://*.zoom.us/*",
				"file:///*/Zoom_Notify/Tester.html"
			],
			"js": [
				"content.js"
			],
			"all_frames": true,
			"run_at": "document_end"
		}
	]
}