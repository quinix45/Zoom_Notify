{
	"manifest_version": 3,
	"name": "Zoom Notify",
	"description": "Sends notifications when new messages are received in chat on Zoom. Make sure to allow notifications from Chrome.",
	"version": "1.0.0",
	"permissions": [
		"nativeMessaging",
		"notifications"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://*.zoom.us/*",
				"file:///*/Zoom_Notify/Tester.html"
			],
			"js": [
				"content.js"
			],
			"all_frames": true,
			"run_at": "document_end"
		}
	],
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"48": "icon48.png",
		"128": "icon128.png",
		"512": "icon512.png"
	}
}