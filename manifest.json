{
  "manifest_version": 3,
  "name": "Zoom Chat Logger Pro",
  "version": "1.2",
  "permissions": ["nativeMessaging"],
  "background": {
  "service_worker": "background.js"
},
  "content_scripts": [
    {
      "matches": [
        "https://*.zoom.us/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}